# Modus Operandi (light)
set -g status-style "bg=#c8c8c8,fg=#000000"
set -g window-status-current-style "fg=#0031a9,bold"
set -g window-status-bell-style "bg=#ff8f88,fg=#000000"
set -g pane-border-style "fg=#9f9f9f"
set -g pane-active-border-style "fg=#0031a9"
set -g popup-border-style "fg=#9f9f9f"
set -g message-style "bg=#f2f2f2,fg=#000000"
set -g message-command-style "bg=#f2f2f2,fg=#000000"
set -g mode-style "bg=#bdbdbd,fg=#000000"
set -g copy-mode-match-style "bg=#f3d000,fg=#000000"
set -g copy-mode-current-match-style "bg=#ff8f88,fg=#000000"
set -g clock-mode-colour "#0031a9"
