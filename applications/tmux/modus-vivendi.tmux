# Modus Vivendi (dark)
set -g status-style "bg=#505050,fg=#ffffff"
set -g window-status-current-style "fg=#2fafff,bold"
set -g window-status-bell-style "bg=#9d1f1f,fg=#ffffff"
set -g pane-border-style "fg=#646464"
set -g pane-active-border-style "fg=#2fafff"
set -g popup-border-style "fg=#646464"
set -g message-style "bg=#1e1e1e,fg=#ffffff"
set -g message-command-style "bg=#1e1e1e,fg=#ffffff"
set -g mode-style "bg=#5a5a5a,fg=#ffffff"
set -g copy-mode-match-style "bg=#7a6100,fg=#ffffff"
set -g copy-mode-current-match-style "bg=#9d1f1f,fg=#ffffff"
set -g clock-mode-colour "#2fafff"
