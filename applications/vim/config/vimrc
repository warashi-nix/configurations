vim9script

language message C
set nocompatible

augroup MyAutoCmd
  autocmd!
augroup END

g:denops#deno = '@deno@'

set runtimepath^=@merged_plugins@

set clipboard=unnamed,unnamedplus

filetype indent on
set autoindent

set autoread
set showcmd
set number
set numberwidth=6
set smartindent
set visualbell
set showmatch
set laststatus=2

set expandtab
set tabstop=2
set shiftwidth=2

set ignorecase
set smartcase
set incsearch
set wrapscan
set hlsearch

# --------------------------------------------------
#  Undo
# --------------------------------------------------

set undofile
const undo_dir = expand('~/.cache/vim/undo')
exec $'set undodir={undo_dir}'
if !isdirectory(undo_dir)
    mkdir(undo_dir, 'p', 0o700)
endif

# --------------------------------------------------
#  Timeouts
# --------------------------------------------------

set timeout
set ttimeout
set timeoutlen=100
set ttimeoutlen=100

set updatetime=300

# --------------------------------------------------
#  Colors
# --------------------------------------------------

set termguicolors
colorscheme modus
syntax enable

# --------------------------------------------------
#  Terminal Cursor Shapes
# --------------------------------------------------

&t_SI = "\e[5 q"  # 垂直棒 (Insert)
&t_SR = "\e[3 q"  # 下線 (Replace)
&t_EI = "\e[2 q"  # ブロック (Normal)

# --------------------------------------------------
#  Skkeleton Configuration
# --------------------------------------------------

def SkkeletonInitialize()
  skkeleton#config({
    sources: ['skk_server']
  })
enddef

inoremap <C-j> <Plug>(skkeleton-enable)

augroup MyAutoCmd
  autocmd User skkeleton-initialize-pre SkkeletonInitialize()
augroup END

# --------------------------------------------------
#  Auto Complete
# --------------------------------------------------

set autocomplete
set complete=.,w,b,u,t,i,o,F,Fskkeleton#completefunc
augroup my-skkeleton-completedone
  autocmd!
  autocmd CompleteDone * call skkeleton#complete_done()
augroup END
